---
// Duas variantes estruturais (nao so de cor):
// - "editorial": split de 2 colunas (texto + ilustracao simples de um
//   aparelho de ar condicionado soltando ar, sobre o fundo em degrade
//   frio/quente .fundo-termico), elemento-assinatura da direção atual
//   (.fio-termico, em src/styles/global.css) como divisor vertical ao lado
//   do texto. Substitui o diagrama técnico com anotações da direção anterior
//   ("Precisão Técnica"), confuso para o cliente ("parece placa de vídeo
//   com varal"): a ilustração agora não tem nenhuma legenda/cota, só o
//   aparelho e o fluxo de ar, para ser reconhecível em poucos segundos.
// - "cartao": titulo em coluna unica com cartao de horario sobreposto.
// Botões usam a classe .botao-cta (degradê pêssego->coral do sol do logo
// real) com texto text-base (ink escuro): ver nota de contraste em
// src/styles/global.css.
import { site } from '../../data/site';
import { cidadeDoEndereco, linkWhatsApp } from '../../lib/endereco';

interface Props {
  variante?: 'editorial' | 'cartao';
  chamada: string;
  subtitulo: string;
}

const { variante = 'editorial', chamada, subtitulo } = Astro.props;
const cidade = cidadeDoEndereco(site.nap.enderecoCurto);
const linkWpp = linkWhatsApp(site.nap.whatsappDigitos, 'Olá, vim pelo site');
const horarioDeHoje = site.horarios[new Date().getDay() === 0 ? 6 : new Date().getDay() - 1];
---

{
  variante === 'editorial' ? (
    <section class="border-b border-linha bg-superficie" aria-labelledby="hero-titulo">
      <div class="mx-auto grid max-w-6xl gap-10 px-6 py-16 md:grid-cols-[auto_1.1fr_0.9fr] md:gap-10 md:py-24">
        <div class="hidden w-2 fio-termico md:block" aria-hidden="true" />
        <div class="max-w-[42ch]">
          <p class="flex items-center gap-2 font-rotulo text-xs font-medium uppercase tracking-[0.1em] text-destaque">
            <span class="h-px w-6 bg-destaque" aria-hidden="true" />
            {site.nicho} · {cidade}
          </p>
          <h1
            id="hero-titulo"
            class="mt-4 font-titulo text-4xl font-extrabold leading-[1.06] tracking-tight text-base md:text-6xl"
          >
            {chamada}
          </h1>
          <p class="mt-5 max-w-[42ch] text-lg text-texto/85">{subtitulo}</p>
          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a
              href={linkWpp}
              class="botao-cta inline-flex items-center gap-2 rounded-[3px] px-6 py-3 font-semibold text-base shadow-[var(--shadow-cartao)] transition-transform hover:-translate-y-0.5 motion-reduce:transition-none motion-reduce:hover:translate-y-0"
            >
              Pedir orçamento pelo WhatsApp
            </a>
            {horarioDeHoje.abertura && (
              <p class="font-rotulo text-sm text-destaque">
                Hoje: {horarioDeHoje.abertura} às {horarioDeHoje.fechamento}
              </p>
            )}
          </div>
        </div>
        <div class="fundo-termico rounded-lg border border-linha p-6" aria-hidden="true">
          <svg
            viewBox="0 0 300 260"
            xmlns="http://www.w3.org/2000/svg"
            class="h-auto w-full"
            role="presentation"
          >
            <!--
              Ilustração simples do aparelho (unidade interior de split) e do
              ar que ele solta, sem nenhuma anotação/cota (diferente da
              direção anterior): o objetivo é ser reconhecível como "ar
              condicionado" imediatamente, não um desenho técnico. Corpo
              claro com contorno escuro, grelha e luz de indicação nas cores
              da marca, fluxo de ar em três curvas com opacidade decrescente
              (sensação de brisa/profundidade) e pequenas partículas soltas,
              tudo só com curvas e círculos: nada de floco de neve nem sol
              desenhados de forma literal.
            -->
            <rect x="45" y="54" width="210" height="58" rx="20" fill="var(--color-superficie)" stroke="var(--color-base)" stroke-width="3" />
            <circle cx="226" cy="70" r="6" fill="var(--color-acento)" />
            <rect x="66" y="96" width="46" height="6" rx="3" fill="var(--color-destaque)" opacity="0.85" />
            <rect x="122" y="96" width="46" height="6" rx="3" fill="var(--color-destaque)" opacity="0.6" />
            <rect x="178" y="96" width="46" height="6" rx="3" fill="var(--color-destaque)" opacity="0.35" />

            <path d="M95 118 C 72 150, 116 172, 92 208" fill="none" stroke="var(--color-destaque)" stroke-width="6" stroke-linecap="round" opacity="0.9" />
            <path d="M152 118 C 129 152, 175 174, 150 214" fill="none" stroke="var(--color-destaque)" stroke-width="6" stroke-linecap="round" opacity="0.6" />
            <path d="M209 118 C 186 150, 230 172, 206 208" fill="none" stroke="var(--color-destaque)" stroke-width="6" stroke-linecap="round" opacity="0.35" />

            <circle cx="108" cy="150" r="4" fill="var(--color-destaque)" opacity="0.5" />
            <circle cx="168" cy="160" r="3" fill="var(--color-destaque)" opacity="0.4" />
            <circle cx="196" cy="140" r="3.5" fill="var(--color-destaque)" opacity="0.3" />
          </svg>
        </div>
      </div>
    </section>
  ) : (
    <section class="relative overflow-hidden border-b border-linha bg-painel" aria-labelledby="hero-titulo">
      <div class="mx-auto max-w-6xl px-6 py-16 md:py-24">
        <p class="font-rotulo text-sm font-medium uppercase tracking-[0.1em] text-destaque">{site.nicho} em {cidade}</p>
        <h1
          id="hero-titulo"
          class="mt-3 max-w-[20ch] font-titulo text-4xl font-extrabold leading-[1.02] text-base md:text-7xl"
        >
          {chamada}
        </h1>
        <div class="mt-8 max-w-md rounded-[var(--radius-cartao)] border border-linha bg-superficie/95 p-6 shadow-[var(--shadow-cartao)]">
          <p class="text-texto/85">{subtitulo}</p>
          <a
            href={linkWpp}
            class="botao-cta mt-5 inline-flex items-center gap-2 rounded-[3px] px-6 py-3 font-semibold text-base transition-transform hover:-translate-y-0.5 motion-reduce:transition-none motion-reduce:hover:translate-y-0"
          >
            Pedir orçamento pelo WhatsApp
          </a>
        </div>
      </div>
    </section>
  )
}
