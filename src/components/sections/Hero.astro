---
// Duas variantes estruturais (nao so de cor):
// - "editorial": foto real de fundo (banco de imagens licenciado Pexels,
//   mãos segurando um manômetro/manifold de refrigerante, ferramentas ao
//   lado; trocada depois de feedback de que a primeira foto (técnico curvado
//   de longe) não comunicava a ação com clareza. Ver nota de origem/licença
//   em PENDENCIAS.md) cobrindo a seção inteira, com .hero-foto-scrim escurecendo
//   o lado do texto (ver src/styles/global.css) e um zoom lento (Ken Burns,
//   neutralizado por prefers-reduced-motion). Foto é decorativa (alt="",
//   aria-hidden), nunca apresentada como o técnico real da empresa. Substitui
//   a ilustração SVG e o diagrama técnico das direções anteriores: o pedido
//   do cliente foi por uma foto real, não desenho, "parece feito no Paint".
// - "cartao": titulo em coluna unica com cartao de horario sobreposto.
// Botões usam a classe .botao-cta (degradê pêssego->coral do sol do logo
// real) com texto text-base (ink escuro): ver nota de contraste em
// src/styles/global.css.
import { Image } from 'astro:assets';
import fotoHero from '../../assets/hero-tecnico.jpg';
import { site } from '../../data/site';
import { cidadeDoEndereco, linkWhatsApp } from '../../lib/endereco';

interface Props {
  variante?: 'editorial' | 'cartao';
  chamada: string;
  subtitulo: string;
}

const { variante = 'editorial', chamada, subtitulo } = Astro.props;
const cidade = cidadeDoEndereco(site.nap.enderecoCurto);
const linkWpp = linkWhatsApp(site.nap.whatsappDigitos, 'Olá, vim pelo site');
const horarioDeHoje = site.horarios[new Date().getDay() === 0 ? 6 : new Date().getDay() - 1];
---

{
  variante === 'editorial' ? (
    <section class="relative flex min-h-[600px] flex-col overflow-hidden border-b border-linha md:min-h-[680px]" aria-labelledby="hero-titulo">
      <div class="absolute inset-0 overflow-hidden" aria-hidden="true">
        <Image
          src={fotoHero}
          alt=""
          class="hero-foto-img h-full w-full object-cover object-[center_38%]"
          widths={[640, 960, 1280, 1920, 2400]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          format="avif"
          quality={48}
        />
        <div class="hero-foto-scrim absolute inset-0" />
      </div>
      <div class="relative mx-auto mt-auto w-full max-w-6xl px-6 py-10 md:py-14">
        <div class="max-w-[42ch]">
          <p class="flex items-center gap-2 font-rotulo text-xs font-medium uppercase tracking-[0.1em] text-acento-inicio">
            <span class="h-px w-6 bg-acento-inicio" aria-hidden="true" />
            {site.nicho} · {cidade}
          </p>
          <h1
            id="hero-titulo"
            class="mt-4 font-titulo text-4xl font-extrabold leading-[1.06] tracking-tight text-superficie [text-shadow:0_2px_16px_rgb(0_0_0/0.35)] md:text-6xl"
          >
            {chamada}
          </h1>
          <p class="mt-5 max-w-[40ch] text-lg text-superficie/90">{subtitulo}</p>
          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a
              href={linkWpp}
              class="botao-cta inline-flex items-center gap-2 rounded-[3px] px-6 py-3 font-semibold text-base shadow-[var(--shadow-cartao)] transition-transform hover:-translate-y-0.5 motion-reduce:transition-none motion-reduce:hover:translate-y-0"
            >
              Pedir orçamento pelo WhatsApp
            </a>
            {horarioDeHoje.abertura && (
              <p class="font-rotulo text-sm text-acento-inicio">
                Hoje: {horarioDeHoje.abertura} às {horarioDeHoje.fechamento}
              </p>
            )}
          </div>
        </div>
      </div>
    </section>
  ) : (
    <section class="relative overflow-hidden border-b border-linha bg-painel" aria-labelledby="hero-titulo">
      <div class="mx-auto max-w-6xl px-6 py-16 md:py-24">
        <p class="font-rotulo text-sm font-medium uppercase tracking-[0.1em] text-destaque">{site.nicho} em {cidade}</p>
        <h1
          id="hero-titulo"
          class="mt-3 max-w-[20ch] font-titulo text-4xl font-extrabold leading-[1.02] text-base md:text-7xl"
        >
          {chamada}
        </h1>
        <div class="mt-8 max-w-md rounded-[var(--radius-cartao)] border border-linha bg-superficie/95 p-6 shadow-[var(--shadow-cartao)]">
          <p class="text-texto/85">{subtitulo}</p>
          <a
            href={linkWpp}
            class="botao-cta mt-5 inline-flex items-center gap-2 rounded-[3px] px-6 py-3 font-semibold text-base transition-transform hover:-translate-y-0.5 motion-reduce:transition-none motion-reduce:hover:translate-y-0"
          >
            Pedir orçamento pelo WhatsApp
          </a>
        </div>
      </div>
    </section>
  )
}
