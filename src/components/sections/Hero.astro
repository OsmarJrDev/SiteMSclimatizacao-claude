---
// Duas variantes estruturais (nao so de cor):
// - "editorial": split de 2 colunas (texto + diagrama tecnico linear de um
//   ar condicionado, com linhas de cota), elemento-assinatura da direção
//   "Precisão Técnica" (.linha-cota, em src/styles/global.css) como divisor
//   vertical ao lado do texto.
// - "cartao": titulo em coluna unica com cartao de horario sobreposto.
// Botões com bg-acento usam text-superficie (não text-texto): ver nota de
// contraste em src/styles/global.css.
import { site } from '../../data/site';
import { cidadeDoEndereco, linkWhatsApp } from '../../lib/endereco';

interface Props {
  variante?: 'editorial' | 'cartao';
  chamada: string;
  subtitulo: string;
}

const { variante = 'editorial', chamada, subtitulo } = Astro.props;
const cidade = cidadeDoEndereco(site.nap.enderecoCurto);
const linkWpp = linkWhatsApp(site.nap.whatsappDigitos, 'Olá, vim pelo site');
const horarioDeHoje = site.horarios[new Date().getDay() === 0 ? 6 : new Date().getDay() - 1];
---

{
  variante === 'editorial' ? (
    <section class="border-b border-linha bg-superficie" aria-labelledby="hero-titulo">
      <div class="mx-auto grid max-w-6xl gap-10 px-6 py-16 md:grid-cols-[auto_1.1fr_0.9fr] md:gap-10 md:py-24">
        <div class="hidden w-2 linha-cota md:block" aria-hidden="true" />
        <div class="max-w-[42ch]">
          <p class="flex items-center gap-2 font-rotulo text-xs font-medium uppercase tracking-[0.1em] text-destaque">
            <span class="h-px w-6 bg-destaque" aria-hidden="true" />
            {site.nicho} · {cidade}
          </p>
          <h1
            id="hero-titulo"
            class="mt-4 font-titulo text-4xl font-extrabold leading-[1.06] tracking-tight text-base md:text-6xl"
          >
            {chamada}
          </h1>
          <p class="mt-5 max-w-[42ch] text-lg text-texto/85">{subtitulo}</p>
          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a
              href={linkWpp}
              class="inline-flex items-center gap-2 rounded-[3px] bg-acento px-6 py-3 font-semibold text-superficie shadow-[var(--shadow-cartao)] transition-transform hover:-translate-y-0.5 motion-reduce:transition-none motion-reduce:hover:translate-y-0"
            >
              Pedir orçamento pelo WhatsApp
            </a>
            {horarioDeHoje.abertura && (
              <p class="font-rotulo text-sm text-destaque">
                Hoje: {horarioDeHoje.abertura} às {horarioDeHoje.fechamento}
              </p>
            )}
          </div>
        </div>
        <div class="rounded-lg border border-linha bg-painel p-4" aria-hidden="true">
          <svg
            viewBox="0 0 300 260"
            xmlns="http://www.w3.org/2000/svg"
            class="h-auto w-full"
            role="presentation"
          >
            <rect x="30" y="30" width="150" height="46" rx="3" fill="none" stroke="var(--color-destaque)" stroke-width="1.2" />
            <line x1="30" y1="20" x2="180" y2="20" stroke="var(--color-destaque)" stroke-width="1" />
            <line x1="30" y1="16" x2="30" y2="24" stroke="var(--color-destaque)" stroke-width="1" />
            <line x1="180" y1="16" x2="180" y2="24" stroke="var(--color-destaque)" stroke-width="1" />
            <text x="30" y="13" font-family="var(--font-rotulo)" font-size="8" fill="var(--color-destaque)">UNIDADE INTERIOR</text>

            <path d="M180 53 C 210 53, 220 70, 245 70" fill="none" stroke="var(--color-destaque)" stroke-width="1.2" stroke-dasharray="3 3" />
            <rect x="245" y="120" width="40" height="70" rx="3" fill="none" stroke="var(--color-destaque)" stroke-width="1.2" />
            <line x1="255" y1="120" x2="255" y2="190" stroke="var(--color-destaque)" stroke-width="0.8" />
            <line x1="265" y1="120" x2="265" y2="190" stroke="var(--color-destaque)" stroke-width="0.8" />
            <line x1="275" y1="120" x2="275" y2="190" stroke="var(--color-destaque)" stroke-width="0.8" />
            <text x="222" y="204" font-family="var(--font-rotulo)" font-size="8" fill="var(--color-destaque)">UNID. EXTERIOR</text>

            <path d="M60 76 L60 108" stroke="var(--color-destaque)" stroke-width="1" />
            <path d="M50 100 L60 108 L70 100" fill="none" stroke="var(--color-destaque)" stroke-width="1" />
            <text x="76" y="106" font-family="var(--font-rotulo)" font-size="8" fill="var(--color-destaque)">FLUXO DE AR</text>

            <line x1="15" y1="30" x2="15" y2="76" stroke="var(--color-linha)" stroke-width="1" />
            <line x1="11" y1="30" x2="19" y2="30" stroke="var(--color-linha)" stroke-width="1" />
            <line x1="11" y1="76" x2="19" y2="76" stroke="var(--color-linha)" stroke-width="1" />
            <text x="1" y="56" font-family="var(--font-rotulo)" font-size="7" fill="var(--color-linha)" transform="rotate(-90 7 56)">ALTURA</text>

            <circle cx="45" cy="53" r="10" fill="none" stroke="var(--color-destaque)" stroke-width="1" />
            <line x1="38" y1="46" x2="52" y2="60" stroke="var(--color-destaque)" stroke-width="0.8" />
            <line x1="52" y1="46" x2="38" y2="60" stroke="var(--color-destaque)" stroke-width="0.8" />
            <text x="34" y="90" font-family="var(--font-rotulo)" font-size="7" fill="var(--color-destaque)">FILTRO</text>
          </svg>
        </div>
      </div>
    </section>
  ) : (
    <section class="relative overflow-hidden border-b border-linha bg-painel" aria-labelledby="hero-titulo">
      <div class="mx-auto max-w-6xl px-6 py-16 md:py-24">
        <p class="font-rotulo text-sm font-medium uppercase tracking-[0.1em] text-destaque">{site.nicho} em {cidade}</p>
        <h1
          id="hero-titulo"
          class="mt-3 max-w-[20ch] font-titulo text-4xl font-extrabold leading-[1.02] text-base md:text-7xl"
        >
          {chamada}
        </h1>
        <div class="mt-8 max-w-md rounded-[var(--radius-cartao)] border border-linha bg-superficie/95 p-6 shadow-[var(--shadow-cartao)]">
          <p class="text-texto/85">{subtitulo}</p>
          <a
            href={linkWpp}
            class="mt-5 inline-flex items-center gap-2 rounded-[3px] bg-acento px-6 py-3 font-semibold text-superficie transition-transform hover:-translate-y-0.5 motion-reduce:transition-none motion-reduce:hover:translate-y-0"
          >
            Pedir orçamento pelo WhatsApp
          </a>
        </div>
      </div>
    </section>
  )
}
