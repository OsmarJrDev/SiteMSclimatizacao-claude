{
  // Config basica de Cloudflare Workers com static assets (1 Worker por
  // cliente, CLAUDE.md secao 3 e 12). Nao configurado de verdade ainda:
  // ajustar "name" para "<mercado>-<nicho>-<cliente>" e criar o Worker
  // antes do primeiro deploy real (npx wrangler deploy).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pt-climatizacao-ms",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
